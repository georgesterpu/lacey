# Local use only. Hosted production uses Sites runtime secrets.
PORT=3000
LOCAL_USER_EMAIL=runner@example.test
# Optional, verified sending domain required. Never use real credentials in source.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
SCAN_SECRET=
# private: Sites authentication protects the scan endpoint; public: SCAN_SECRET required.
SITE_ACCESS=private
