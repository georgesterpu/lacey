# Local use only. Hosted production uses Sites runtime secrets.
PORT=3000
# Optional, verified sending domain required. Never use real credentials in source.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000

# A strong random secret shared only with the deterministic scheduler.
CRON_SECRET=
# Hard global cap on delivery attempts, including confirmations.
DAILY_EMAIL_LIMIT=100
